{
	"name": "@orgsdk/plugin-google-tasks",
	"version": "1.0.2",
	"description": "Google Tasks operations: task lists and tasks (shares google-oauth with google-sheets)",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"validate": "orgsdk-plugin validate",
		"package": "orgsdk-plugin package",
		"version-guard": "orgsdk-plugin version-guard",
		"publish": "orgsdk-plugin publish",
		"build": "bun run typecheck && bun run validate && bun run package"
	},
	"dependencies": {
		"@googleapis/tasks": "^12.0.0",
		"google-auth-library": "^10.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@orgsdk/plugins": "0.2.2",
		"@types/bun": "^1.3.9",
		"typescript": "~6.0.3"
	},
	"overrides": {
		"google-auth-library": "10.9.0"
	}
}
